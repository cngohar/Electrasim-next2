{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@workspace/electrasim-v2",
    "build": "npm run build --workspace=@workspace/electrasim-v2",
    "test:assistant": "node scripts/assistant-regression.cjs",
    "typecheck:libs": "tsc --build --force",
    "typecheck": "npm run typecheck:libs && npm run typecheck --workspaces --if-present",
    "lint": "npm run typecheck"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1",
    "@types/three": "^0.185.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "playwright": "^1.54.2",
    "prettier": "^3.9.5",
    "typescript": "~5.9.3"
  }
}
